{
  "name": "Vyne-Take-Home-Assessment",
  "packageManager": "yarn@4.14.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0"
  },
  "scripts": {
    "test:saucedemo": "playwright test --config=playwright/apps/saucedemo/saucedemo.config.ts",
    "test:saucedemo:ui": "playwright test --config=playwright/apps/saucedemo/saucedemo.config.ts --ui",
    "test:saucedemo:headed": "playwright test --config=playwright/apps/saucedemo/saucedemo.config.ts --headed",
    "test:saucedemo:smoke": "playwright test --config=playwright/apps/saucedemo/saucedemo.config.ts --grep @smoke",
    "test:saucedemo:regression": "playwright test --config=playwright/apps/saucedemo/saucedemo.config.ts --grep @regression",
    "test:jsonplaceholder": "playwright test --config=playwright/apps/jsonplaceholder/jsonplaceholder.config.ts",
    "test:jsonplaceholder:smoke": "playwright test --config=playwright/apps/jsonplaceholder/jsonplaceholder.config.ts --grep @smoke",
    "test:jsonplaceholder:regression": "playwright test --config=playwright/apps/jsonplaceholder/jsonplaceholder.config.ts --grep @regression",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  }
}
